{
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "frameworksBackend": {
      "region": "us-central1",
      "memory": "512MiB"
    },
    "predeploy": [
      "npm run firebase:package-matchup-archive",
      "npm run firebase:package-trade-valuations",
      "npm run firebase:trade-valuations-package-diagnostics"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
